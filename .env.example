# Supabase Project Credentials (Free Tier, No Credit Card)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push VAPID Public Key (Base64URL-encoded uncompressed P-256 point)
# Generated via: node scripts/generate-vapid-keys.mjs
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-base64url
